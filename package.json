{
  "name": "hectorrlove",
  "version": "1.0.0",
  "description": "Personal project hub for hectorrlove.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "start": "web-dev-server --root-dir dist --app-index index.html --port 8018",
    "start:build": "pnpm run build && pnpm run start",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "format": "eslint \"src/**/*.{ts,js}\" --fix && prettier \"**/*.{ts,css,json,md,html}\" --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@web/dev-server": "^0.4.6",
    "@web/rollup-plugin-html": "^2.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-lit": "^2.3.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
